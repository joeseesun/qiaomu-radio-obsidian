{
  "name": "qiaomu-radio-obsidian",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Distraction-free live radio for Obsidian",
  "license": "GPL-3.0-or-later",
  "author": "向阳乔木 (https://x.com/vista8)",
  "repository": { "type": "git", "url": "git+https://github.com/joeseesun/qiaomu-radio-obsidian.git" },
  "scripts": {
    "dev": "node esbuild.plugin.mjs --watch",
    "test": "vitest run plugin-src",
    "test:plugin": "vitest run plugin-src",
    "build": "tsc -p tsconfig.plugin.json --noEmit && node esbuild.plugin.mjs",
    "build:plugin": "npm run build",
    "check": "npm test && npm run build && node scripts/verify-boundary.mjs"
  },
  "dependencies": { "hls.js": "1.7.3" },
  "devDependencies": {
    "@types/node": "26.5.1", "esbuild": "0.28.2", "obsidian": "1.13.1",
    "typescript": "7.0.2", "vitest": "5.0.0"
  }
}
